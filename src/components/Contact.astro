---
import Icon from './Icon.astro';
import Slot from './Slot.astro';
import { legalFieldOptions } from '../data/practice-areas';
import { site, telHref } from '../data/site';

const fieldClass =
  'mt-1.5 block w-full rounded-md border border-line bg-paper px-3.5 py-3 text-base text-ink transition-colors duration-150 placeholder:text-ink-soft/70 hover:border-kraft-deep focus:border-seal focus:outline-none aria-[invalid=true]:border-seal';
---

<section id="lien-he" class="bg-ink px-4 py-20 text-paper md:px-8 md:py-28">
  <!-- Mobile order: intro, form, map. Desktop: intro and map on the left, form on the right. -->
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-x-16">
    <div>
      <h2 class="section-title">Gửi vụ việc cho luật sư</h2>
      <p class="mt-4 max-w-[44ch] text-[1.05rem] text-ink-on-dark">
        Điền phiếu tiếp nhận hoặc liên hệ trực tiếp. Luật sư phụ trách sẽ gọi lại để tư vấn ban đầu miễn phí.
      </p>

      <ul class="mt-10 grid gap-5">
        <li class="flex gap-4">
          <Icon name="map-pin" class="mt-0.5 size-5 shrink-0 text-kraft-deep" />
          <span><Slot value={site.address} /></span>
        </li>
        <li class="flex gap-4">
          <Icon name="phone" class="mt-0.5 size-5 shrink-0 text-kraft-deep" />
          <a href={telHref(site.hotline)} class="text-paper"><Slot value={site.hotline} /></a>
        </li>
        <li class="flex gap-4">
          <Icon name="mail" class="mt-0.5 size-5 shrink-0 text-kraft-deep" />
          <a href={`mailto:${site.email}`} class="break-all text-paper"><Slot value={site.email} /></a>
        </li>
        <li class="flex gap-4">
          <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-kraft-deep" />
          <span><Slot value={site.workingHours} /></span>
        </li>
        <li class="flex gap-4">
          <Icon name="message" class="mt-0.5 size-5 shrink-0 text-kraft-deep" />
          {
            site.zaloUrl ? (
              <a href={site.zaloUrl} target="_blank" rel="noopener" class="text-paper">
                Nhắn tin qua Zalo Official Account
              </a>
            ) : (
              <span>
                Zalo OA: <span class="ph-slot">[Link Zalo Official Account]</span>
              </span>
            )
          }
        </li>
      </ul>
    </div>

    <div class="relative self-start rounded-lg bg-paper p-6 text-ink shadow-[0_24px_48px_-24px_rgb(0_0_0/0.6)] md:p-9 lg:row-span-2">
      <form id="lead-form" novalidate>
        <h3 class="text-2xl font-medium">Phiếu tiếp nhận yêu cầu tư vấn</h3>
        <p class="mt-2 text-ink-soft">Mục có dấu <span class="text-seal">*</span> là bắt buộc.</p>

        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          <label class="block sm:col-span-2">
            <span class="font-medium">Họ và tên <span class="text-seal">*</span></span>
            <input name="full_name" type="text" autocomplete="name" required maxlength="120" class={fieldClass} />
            <span class="field-error mt-1 hidden text-sm text-seal" data-for="full_name">Vui lòng nhập họ và tên.</span>
          </label>
          <label class="block">
            <span class="font-medium">Số điện thoại <span class="text-seal">*</span></span>
            <input name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="20" placeholder="09xx xxx xxx" class={fieldClass} />
            <span class="field-error mt-1 hidden text-sm text-seal" data-for="phone">Số điện thoại chưa đúng, ví dụ 0912 345 678.</span>
          </label>
          <label class="block">
            <span class="font-medium">Email</span>
            <input name="email" type="email" autocomplete="email" maxlength="200" class={fieldClass} />
            <span class="field-error mt-1 hidden text-sm text-seal" data-for="email">Email chưa đúng định dạng, ví dụ ten@gmail.com.</span>
          </label>
          <label class="block sm:col-span-2">
            <span class="font-medium">Lĩnh vực cần tư vấn <span class="text-seal">*</span></span>
            <select name="legal_field" required class={fieldClass}>
              <option value="">Chọn lĩnh vực</option>
              {legalFieldOptions.map((name) => <option value={name}>{name}</option>)}
            </select>
            <span class="field-error mt-1 hidden text-sm text-seal" data-for="legal_field">Vui lòng chọn một lĩnh vực.</span>
          </label>
          <label class="block sm:col-span-2">
            <span class="font-medium">Tóm tắt vụ việc</span>
            <textarea name="message" rows="5" maxlength="4000" placeholder="Sự việc xảy ra khi nào, các bên liên quan, bạn mong muốn giải quyết thế nào." class={fieldClass}></textarea>
          </label>
          <!-- Honeypot: hidden from people, bots tend to fill it. -->
          <label class="absolute -left-[9999px]" aria-hidden="true">
            Website
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>
          <label class="flex gap-3 sm:col-span-2">
            <input name="consent" type="checkbox" required class="mt-1 size-4 shrink-0 accent-seal" />
            <span class="text-[0.95rem] text-ink-soft">
              Tôi đồng ý để {site.name} lưu và sử dụng thông tin trên nhằm liên hệ tư vấn. <span class="text-seal">*</span>
            </span>
          </label>
          <span class="field-error -mt-3 hidden text-sm text-seal sm:col-span-2" data-for="consent">Vui lòng đánh dấu đồng ý để chúng tôi có thể liên hệ.</span>
        </div>

        <button type="submit" class="btn btn-seal mt-8 w-full sm:w-auto">
          <span data-label>Gửi yêu cầu tư vấn</span>
        </button>
        <p id="lead-form-status" role="alert" class="mt-4 hidden rounded-md bg-seal/10 p-3 text-[0.95rem] text-seal-deep"></p>
      </form>

      <div id="lead-form-success" class="hidden py-10 text-center" tabindex="-1">
        <div class="stamp mx-auto flex size-36 -rotate-6 items-center justify-center rounded-full border-[3px] border-seal text-seal">
          <div class="flex size-[7.75rem] flex-col items-center justify-center rounded-full border border-seal font-display">
            <span class="text-sm tracking-wide">LUẬT LVT</span>
            <span class="text-lg leading-tight font-semibold">ĐÃ TIẾP NHẬN</span>
          </div>
        </div>
        <h3 class="mt-8 text-2xl font-medium">Cảm ơn bạn đã gửi thông tin</h3>
        <p class="mx-auto mt-3 max-w-[38ch] text-ink-soft">
          Luật sư sẽ gọi lại theo số điện thoại bạn để lại. Cần gấp, vui lòng gọi
          <a href={telHref(site.hotline)} class="font-medium text-seal"><Slot value={site.hotline} /></a>.
        </p>
      </div>
    </div>

    <div class="overflow-hidden rounded-lg lg:-mt-2">
      {
        site.mapEmbedUrl ? (
          <iframe
            src={site.mapEmbedUrl}
            title={`Bản đồ đến văn phòng ${site.name}`}
            class="aspect-[4/3] w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
        ) : (
          <p class="flex aspect-[4/3] items-center justify-center rounded-lg border-2 border-dashed border-ink-soft p-6 text-center text-ink-on-dark">
            <span>
              Bản đồ Google Maps: dán link nhúng vào <code>mapEmbedUrl</code> trong src/data/site.ts
            </span>
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .stamp {
    animation: stamp 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes stamp {
    from {
      opacity: 0;
      transform: rotate(-14deg) scale(1.35);
    }
  }
</style>

<script>
  import { submitLead, type LeadInput } from '../lib/leads';

  const form = document.querySelector<HTMLFormElement>('#lead-form')!;
  const success = document.querySelector<HTMLElement>('#lead-form-success')!;
  const status = document.querySelector<HTMLElement>('#lead-form-status')!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const buttonLabel = button.querySelector<HTMLElement>('[data-label]')!;

  const phonePattern = /^(\+?84|0)\d{9,10}$/;
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function setError(name: string, invalid: boolean) {
    form.querySelector(`.field-error[data-for="${name}"]`)?.classList.toggle('hidden', !invalid);
    const field = form.elements.namedItem(name);
    if (field instanceof HTMLElement) field.setAttribute('aria-invalid', String(invalid));
  }

  function validate(data: FormData) {
    const phone = String(data.get('phone') ?? '').replace(/[\s.\-()]/g, '');
    const email = String(data.get('email') ?? '').trim();
    const checks: Record<string, boolean> = {
      full_name: String(data.get('full_name') ?? '').trim().length > 0,
      phone: phonePattern.test(phone),
      email: email === '' || emailPattern.test(email),
      legal_field: String(data.get('legal_field') ?? '') !== '',
      consent: data.get('consent') === 'on',
    };
    Object.entries(checks).forEach(([name, ok]) => setError(name, !ok));
    const firstInvalid = Object.keys(checks).find((name) => !checks[name]);
    if (firstInvalid) (form.elements.namedItem(firstInvalid) as HTMLElement | null)?.focus();
    return firstInvalid ? null : phone;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    status.classList.add('hidden');
    const data = new FormData(form);

    // Bot filled the honeypot: pretend success, store nothing.
    if (String(data.get('website') ?? '') !== '') {
      form.classList.add('hidden');
      success.classList.remove('hidden');
      return;
    }

    const phone = validate(data);
    if (!phone) return;

    const lead: LeadInput = {
      full_name: String(data.get('full_name')).trim(),
      phone,
      email: String(data.get('email') ?? '').trim() || null,
      legal_field: String(data.get('legal_field')),
      message: String(data.get('message') ?? '').trim() || null,
    };

    button.disabled = true;
    buttonLabel.textContent = 'Đang gửi…';
    try {
      await submitLead(lead);
      form.classList.add('hidden');
      success.classList.remove('hidden');
      success.focus();
    } catch (error) {
      console.error(error);
      status.textContent =
        'Chưa gửi được yêu cầu do lỗi kết nối. Vui lòng thử lại sau ít phút hoặc gọi hotline để được hỗ trợ ngay.';
      status.classList.remove('hidden');
    } finally {
      button.disabled = false;
      buttonLabel.textContent = 'Gửi yêu cầu tư vấn';
    }
  });
</script>
