---
// Temporary brand mark (round seal with the initials). Replace with the firm's real logo.
interface Props {
  class?: string;
}

const { class: className = 'size-9' } = Astro.props;
---

<svg viewBox="0 0 40 40" aria-hidden="true" class={className}>
  <circle cx="20" cy="20" r="18.5" fill="none" stroke="currentColor" stroke-width="1.5" />
  <circle cx="20" cy="20" r="15" fill="none" stroke="currentColor" stroke-width="0.75" />
  <text
    x="20"
    y="24.2"
    text-anchor="middle"
    fill="currentColor"
    font-family="Literata Variable, Georgia, serif"
    font-size="11.5"
    font-weight="600">LVT</text
  >
</svg>
