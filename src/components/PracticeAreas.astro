---
import Icon from './Icon.astro';
import { practiceAreas } from '../data/practice-areas';
---

<section id="linh-vuc" class="bg-paper px-4 py-20 md:px-8 md:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <h2 class="section-title">Lĩnh vực hành nghề</h2>
      <p class="mt-4 text-[1.05rem] text-ink-soft">
        Chọn đúng hồ sơ giống vấn đề của bạn, luật sư phụ trách lĩnh vực đó sẽ liên hệ lại.
      </p>
    </div>

    <ul class="mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        practiceAreas.map((area) => (
          <li class="group relative flex flex-col rounded-lg rounded-tl-none bg-kraft p-6 pt-7 transition-colors duration-200 hover:bg-kraft-deep/60">
            <span class="absolute -top-7 left-0 flex h-7 items-center gap-1.5 rounded-t-lg bg-kraft px-4 text-sm font-medium text-ink-soft transition-colors duration-200 group-hover:bg-kraft-deep/60">
              <Icon name="folder" class="size-3.5" />
              Hồ sơ
            </span>
            <h3 class="text-[1.4rem] font-medium">{area.name}</h3>
            <p class="mt-3 grow text-ink-soft">{area.scope}</p>
            <a
              href="#lien-he"
              data-legal-field={area.name}
              class="mt-6 inline-flex items-center gap-1.5 self-start font-medium text-seal no-underline hover:text-seal-deep hover:underline"
            >
              Hỏi luật sư về vấn đề này
              <Icon name="arrow-right" class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Preselect the matching legal field in the lead form.
  document.querySelectorAll<HTMLAnchorElement>('a[data-legal-field]').forEach((link) => {
    link.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#lead-form select[name="legal_field"]');
      if (select) select.value = link.dataset.legalField ?? '';
    });
  });
</script>
