---
import MediaList, { type MediaItem } from './MediaList.astro';
import mockTrialDrugs from '../../static/img/congtyluatlvt_2.jpg';
import mockTrialTraffic from '../../static/img/congtyluatlvt_3.jpg';
import ceremony from '../../static/img/congtyluatlvt_6.jpg';
import arbitrationClass from '../../static/img/congtyluatlvt_7.jpg';
import { isPlaceholder } from '../data/site';

// Captions only state what is readable on the banners in each photo.
const activities = [
  {
    image: mockTrialDrugs,
    caption: 'Phiên tòa giả định chuyên đề “Phòng chống ma túy và tác hại thuốc lá”',
    meta: 'Tân Phú, 16/11/2024',
  },
  {
    image: arbitrationClass,
    caption: 'Lớp tập huấn pháp luật về trọng tài',
    meta: 'Đồng Nai, 28/4/2022',
  },
  {
    image: mockTrialTraffic,
    caption: 'Phiên tòa giả định xét xử vụ án “Vi phạm luật giao thông đường bộ”',
    meta: 'Tân Phú',
  },
  {
    image: ceremony,
    caption: '[Tên sự kiện / giải thưởng]',
    meta: '[Địa điểm, ngày]',
  },
];

const items: MediaItem[] = activities.map((activity) => ({
  image: activity.image,
  alt: isPlaceholder(activity.caption) ? 'Hoạt động của Công ty Luật LVT' : activity.caption,
  title: activity.caption,
  meta: activity.meta,
}));
---

<section aria-labelledby="hoat-dong-title" class="bg-paper px-4 py-20 md:px-8 md:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <h2 id="hoat-dong-title" class="section-title" data-reveal="rise">CÁC HOẠT ĐỘNG PHỔ BIẾN PHÁP LUẬT</h2>
    </div>
    <MediaList items={items} />
  </div>
</section>
