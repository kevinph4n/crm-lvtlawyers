---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Rosette from './Rosette.astro';
import Slot from './Slot.astro';
import heroImage from '../../static/img/congtyluatlvt_1.jpg';
import { site, telHref } from '../data/site';
---
<section class="relative isolate flex min-h-[38rem] items-end overflow-hidden bg-ink text-paper md:min-h-[44rem]">
  <div class="hero-photo absolute inset-0 -z-10">
    <Picture
      src={heroImage}
      formats={['avif', 'webp']}
      widths={[480, 890]}
      sizes="100vw"
      alt="Luật sư Công ty Luật LVT trao đổi hồ sơ tại phiên tòa"
      loading="eager"
      fetchpriority="high"
      class="size-full object-cover object-[60%_20%]"
    />
  </div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/80 to-ink/25 md:bg-gradient-to-r md:from-ink/95 md:via-ink/75 md:to-ink/10"></div>
  <div class="hero-mark pointer-events-none absolute -bottom-40 -left-36 -z-10 size-[28rem] text-ink-on-dark md:-bottom-56 md:-left-40 md:size-[44rem]">
    <Rosette id="hero-rosette" class="size-full" />
  </div>

  <div class="mx-auto w-full max-w-6xl px-4 pt-32 pb-12 md:px-8 md:pb-20">
    <p class="hero-in mb-5 flex items-center gap-3 text-[0.95rem] text-ink-on-dark" style="--i: 0">
      <span class="h-px w-8 bg-kraft-deep" aria-hidden="true"></span>
      {site.name}
    </p>
    <h1 class="hero-in max-w-[15ch] text-[2.4rem] font-medium md:text-[3.6rem]" style="--i: 1">{site.slogan}</h1>
    <p class="hero-in mt-5 max-w-[46ch] text-[1.05rem] text-ink-on-dark" style="--i: 2">
      Đồng hành cùng đội ngũ luật sư chuyên nghiệp của LVT Lawyers, với hơn <strong class="font-semibold text-paper"><Slot value={site.yearsOfExperience} /> năm</strong> kinh nghiệm hành nghề luật.
    </p>
    <div class="hero-in mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6" style="--i: 3">
      <a href="#lien-he" class="btn btn-seal self-start">
        Nhận tư vấn miễn phí
        <Icon name="arrow-right" class="size-4" />
      </a>
      <a href={telHref(site.hotline)} class="inline-flex items-center gap-2 text-ink-on-dark no-underline hover:text-paper hover:underline">
        <Icon name="phone" class="size-4" />
        hoặc gọi <span class="font-semibold text-paper tabular-nums"><Slot value={site.hotline} /></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-mark {
    opacity: 0.1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-photo {
      animation: hero-photo 1800ms var(--ease-out-soft) both;
    }
    .hero-mark {
      animation: hero-mark 1600ms var(--ease-out-soft) 300ms both;
    }
    .hero-in {
      animation: hero-in 900ms var(--ease-out-soft) both;
      animation-delay: calc(var(--i) * 110ms + 150ms);
    }
  }
  @keyframes hero-photo {
    from {
      transform: scale(1.08);
    }
  }
  @keyframes hero-mark {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
</style>
